# Copy sang .env rồi điền. Giá trị nội bộ hỏi team, đừng commit file .env.
# Base URL phải kèm đúng sub-path của instance, thiếu là 502
GRAFANA_URL=
GRAFANA_ORG=
# Service account token, quyền Viewer là đủ
GRAFANA_TOKEN=

# UID datasource — lấy từ Grafana > Connections > Data sources
PROM_UID=
PROM1_UID=
# Nếu có nhiều Loki với label set khác nhau thì khai báo đủ, chọn đúng cái theo service
LOKI_UID=
LOKI1_UID=
TEMPO_UID=
